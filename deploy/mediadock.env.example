# MediaDock full local stack
# Copy this file to deploy/mediadock.env before starting Compose.

# Local-only convenience. Set false before exposing the stack beyond localhost.
AUTH_DISABLED=true

# MediaDock keeps these values inside the Compose network.
DOWNLOADERS=qbittorrent
QBITTORRENT_USER=admin
# Set this to the qBittorrent WebUI password after first login.
QBITTORRENT_PASSWORD=change-me

# Prowlarr creates its API key from the WebUI on first setup.
# Replace this before using Prowlarr search.
PROWLARR_API_KEY=replace-with-prowlarr-api-key

# Keep API-only acquisition: qBittorrent owns /downloads.
# Do not set DOWNLOAD_INCOMING_DIR for this stack.

# Optional host port overrides.
MEDIADOCK_HTTP_PORT=8080
PANSOU_HTTP_PORT=8888
PROWLARR_HTTP_PORT=9696
QBITTORRENT_HTTP_PORT=8081
QBITTORRENT_TORRENT_PORT=6881

TZ=Asia/Shanghai
PUID=1000
PGID=1000
