# Server deployment. MediaDock and OpenList HTTP ports bind to 127.0.0.1;
# use an SSH tunnel or a TLS reverse proxy to access them remotely.
AUTH_DISABLED=false
MCP_ENABLED=true

# MediaDock submits magnets directly to qBittorrent and cloud-share/COPY
# operations to the OpenList fork. Configure credentials below before use.
DOWNLOADERS=qbittorrent,openlist
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=
PROWLARR_API_KEY=

# OpenList's dedicated API token is created after its first-run setup.
OPENLIST_AUTH_TOKEN=
OPENLIST_TARGET_PROFILE=openlist_default
OPENLIST_DEST_DIR=

# Search timeout for slow external PanSou providers.
SEARCH_TIMEOUT=90s

# Docker Compose interpolation values. Keep the management UIs on loopback;
# only the qBittorrent peer port is published on all interfaces by default.
PUID=1000
PGID=1000
TZ=Asia/Shanghai
MEDIADOCK_HTTP_PORT=8080
OPENLIST_HTTP_PORT=5244
PROWLARR_HTTP_PORT=9696
QBITTORRENT_HTTP_PORT=8081
QBITTORRENT_TORRENT_PORT=6881
