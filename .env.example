# HTTP API exposed to Hermes / an LLM tool caller.
HTTP_ADDR=:8080

# Standard MCP Streamable HTTP endpoint.
MCP_ENABLED=true
MCP_PATH=/mcp
# Set this when the endpoint is reachable outside a trusted private network.
MCP_AUTH_TOKEN=

# At least one search provider is needed for /api/v1/search.
# PanSou / pansou-web exposes POST /api/search.
PANSOU_BASE_URL=http://127.0.0.1:80

# Optional Prowlarr-compatible indexer aggregation.
PROWLARR_BASE_URL=
PROWLARR_API_KEY=

# Optional, comma-separated downloader adapters. Leave empty for search-only mode.
# Currently supported: transmission
DOWNLOADERS=

# Transmission RPC endpoint, used only when DOWNLOADERS contains transmission.
# When MediaDock runs in Docker,
# use the path visible inside the Transmission container/network.
TRANSMISSION_RPC_URL=http://127.0.0.1:9091/transmission/rpc
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=

# Must be the same path visible to both MediaDock and Transmission.
DOWNLOAD_INCOMING_DIR=./data/downloads/incoming

SEARCH_TIMEOUT=30s
SEARCH_SESSION_TTL=30m
